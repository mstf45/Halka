<Window x:Class="Halka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Halka"
        Width="680"
        Height="820"
        MinWidth="560"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#14161C"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <Style x:Key="OnGreen" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#102418"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Style>
                        </ControlTemplate.Resources>
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="Halka" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,14" Foreground="#B7B1A6" TextWrapping="Wrap"
                       Text="Dosya bu bilgisayarda kalır. Ctrl basılı sürükleyince halka açılır."/>

            <Border x:Name="DropZone" AllowDrop="True" CornerRadius="16" BorderBrush="#3C414D" BorderThickness="1.5"
                    Background="#1C1F27" Padding="16,14" Margin="0,0,0,16"
                    DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dosya seç" VerticalAlignment="Center" Margin="12,0,0,0" Click="PickButton_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dosyaları buraya bırak" FontSize="16"/>
                        <TextBlock Text="Birden fazla görsel, HEIC dahil. Biçimi halkadan seçersin" Foreground="#9A948A" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Background="#16803C" CornerRadius="16" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Link" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Margin="0,4,0,10" Foreground="#E8FFE9" TextWrapping="Wrap"
                               Text="Linki yapıştır. Video ve ses biçimleri gelsin, istediğin satırdan indir. Kayıt: İndirilenler\Halka"/>
                    <TextBox x:Name="LinkBox" MinHeight="36" Background="White" Foreground="Black" BorderBrush="#D7F3DE"
                             CaretBrush="Black" Padding="10,8" KeyDown="LinkBox_KeyDown" DataObject.Pasting="LinkBox_Pasting"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource OnGreen}" Click="PasteButton_Click">
                            <TextBlock Text="Yapıştır" Foreground="#102418"/>
                        </Button>
                        <Button x:Name="FetchButton" Margin="8,0,0,0" Style="{StaticResource OnGreen}" Click="FetchButton_Click">
                            <TextBlock Text="Biçimleri getir" Foreground="#102418"/>
                        </Button>
                        <Button x:Name="PdfButton" Margin="8,0,0,0" Style="{StaticResource OnGreen}" Click="PdfButton_Click">
                            <TextBlock Text="Sayfayı PDF" Foreground="#102418"/>
                        </Button>
                        <Button x:Name="LinkCancel" Margin="8,0,0,0" Style="{StaticResource OnGreen}" Visibility="Collapsed" Click="LinkCancel_Click">
                            <TextBlock Text="Vazgeç" Foreground="#102418"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="LinkStatus" Margin="0,10,0,0" Foreground="White" TextWrapping="Wrap"/>

                    <StackPanel x:Name="FormatHost" Visibility="Collapsed" Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="MediaDuration" DockPanel.Dock="Right" Foreground="White" FontWeight="SemiBold" Margin="12,0,0,0"/>
                            <TextBlock x:Name="MediaTitle" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="VideoTab" Style="{StaticResource OnGreen}" Margin="0,0,8,0" Click="VideoTab_Click">
                                <TextBlock Text="Video" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="AudioTab" Style="{StaticResource OnGreen}" Background="Transparent" Foreground="White" Click="AudioTab_Click">
                                <TextBlock Text="Ses" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Biçim" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Boyut" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="İşlem" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FormatList" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#3EAF62" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="108"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="#E8FFE9" FontSize="12"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="White" VerticalAlignment="Center"/>
                                                <Button Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource OnGreen}"
                                                        Tag="{Binding}" Click="OfferDownload_Click">
                                                    <TextBlock Text="İndir" Foreground="#102418"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyFormats" Foreground="White" Visibility="Collapsed" Margin="0,8,0,0"/>
                    </StackPanel>
                    <wv2:WebView2 x:Name="PageView" Height="0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Son dönüşümler" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="RecentList" MinHeight="88" MaxHeight="140" MouseDoubleClick="RecentList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Mark}" Foreground="#E0A045"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="#9A948A" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Çift tık, sonucu klasörde gösterir." Foreground="#9A948A" FontSize="12" Margin="0,6,0,0"/>

            <Expander Header="Ayarlar" Foreground="#F3EFE6" Margin="0,16,0,0">
                <StackPanel Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock x:Name="QualityLabel" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="JPG / WEBP kalitesi" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                        <Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="85" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Margin="0,12,0,4" Foreground="#B7B1A6" Text="FFmpeg (boşsa, gereken indirmede kurulur)"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Gözat" Margin="8,0,0,0" Click="BrowseFfmpeg_Click"/>
                        <TextBox x:Name="FfmpegBox"/>
                    </DockPanel>
                    <TextBlock x:Name="FfmpegState" Margin="0,6,0,8" Foreground="#9A948A" TextWrapping="Wrap"/>
                    <CheckBox x:Name="GestureCheck" Content="Ctrl ile sürükleyince halkayı aç" Margin="0,4,0,0"/>
                    <CheckBox x:Name="StartupCheck" Content="Windows açılınca başlat" Margin="0,6,0,0"/>
                    <CheckBox x:Name="HomeCheck" Content="Açılışta bu pencereyi göster" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HookState" Margin="0,12,0,0" Foreground="#9A948A" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,10,0,0" Foreground="#9A948A" TextWrapping="Wrap"
                               Text="Dosya dönüşümü: görsel, PDF, DOCX, XLSX ve ZIP. Sayfa PDF'i ve video, yukarıdaki bağlantı kutusundan."/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>
